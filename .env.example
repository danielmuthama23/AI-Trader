# ═════════════════════════════════════════════════════════════\n# AI TRADING AGENT — Environment Configuration\n# ═════════════════════════════════════════════════════════════\n\n# ── ANTHROPIC (CLAUDE AI) ────────────────────────────────────\n# Get from: https://console.anthropic.com/account/keys\nANTHROPIC_API_KEY=sk-ant-your-api-key-here\n\n# ── HEDERA HASHGRAPH (Optional: Blockchain Audit) ────────────\n# Get from: https://portal.hedera.com\nHEDERA_ACCOUNT_ID=0.0.123456\nHEDERA_PRIVATE_KEY=302e020100300506032b6570042204203...\nHEDERA_TOPIC_ID=0.0.123457\n\n# ── SENDGRID (Optional: Email Alerts) ────────────────────────\n# Get from: https://sendgrid.com/account/api-keys\nSENDGRID_API_KEY=SG.xxxx_your_sendgrid_key\nALERT_FROM_EMAIL=trading-alerts@yourdomain.com\n\n# ── MARKET DATA (Optional: Live Prices) ──────────────────────\n# Get from: https://www.alphavantage.co/api/#api-key-equity-intraday\nALPHA_VANTAGE_KEY=your_alpha_vantage_key\n\n# Get from: https://newsapi.org/register\nNEWS_API_KEY=your_newsapi_key\n\n# ── FABRIC IQ (Optional: Enterprise RAG) ─────────────────────\n# Get from: https://fabriciq.ai\nFABRICIQ_API_KEY=fiq-your-key\n\n# ── DATABASE ─────────────────────────────────────────────────\n# Default works with docker-compose, change for local setup\nDATABASE_URL=postgresql://postgres:password@db:5432/trading\nREDIS_URL=redis://redis:6379\n\n# ── SECURITY ─────────────────────────────────────────────────\nAPI_SECRET_KEY=your-secure-random-key-here\n\n# ── SERVER ───────────────────────────────────────────────────\nPORT=8000\nNODE_ENV=development\nAI_SERVICE_URL=http://ai-service:8001\n"